---
import Base from '../../layouts/Base.astro';
import { getListedPosts, tagSlug } from '../../lib/posts';

const posts = await getListedPosts();
const counts = new Map<string, number>();
for (const tag of posts.flatMap((post) => post.data.tags)) {
  counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base title="Tags">
  <h1 class="page-title">Tags</h1>
  {
    tags.length > 0 ? (
      tags.map(([tag, count]) => (
        <a class="tag" href={`/tag/${tagSlug(tag)}/`}>
          {tag}
          <span class="tag-count">{count}</span>
        </a>
      ))
    ) : (
      <p class="empty-state">No tags yet.</p>
    )
  }
</Base>
