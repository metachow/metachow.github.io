---
import Base from '../../layouts/Base.astro';
import { formatDate, getListedPosts } from '../../lib/posts';

const posts = await getListedPosts();
const years = Map.groupBy(posts, (post) => post.data.date.getUTCFullYear());
---

<Base title="Archives">
  <h1 class="page-title">Archives</h1>
  {
    [...years].map(([year, yearPosts]) => (
      <section class="archives-container">
        <h2 class="year">{year}</h2>
        {yearPosts.map((post) => (
          <div class="post">
            <time class="date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date).slice(5)}</time>
            <a href={`/post/${post.id}/`}><h3 class="post-title">{post.data.title}</h3></a>
          </div>
        ))}
      </section>
    ))
  }
</Base>
