---
import { Image } from 'astro:assets';
import { faArchive, faFeatherAlt, faMoon, faRss, faSun, faTags, faUser } from '@fortawesome/free-solid-svg-icons';
import FaIcon from './FaIcon.astro';
import avatar from '../assets/avatar.png';
import { NAV, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const icons = { posts: faFeatherAlt, archives: faArchive, tags: faTags, about: faUser };

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/') {
    // Individual posts count as "Posts", except the About page which has its own entry.
    return path === '/' || (path.startsWith('/post/') && path !== '/post/about');
  }
  if (target === '/tags') return path === '/tags' || path.startsWith('/tag/');
  return path === target;
}
---

<aside class="sidebar" id="sidebar">
  <div class="top-container">
    <div class="top-header-container">
      <a class="site-title-container" href="/">
        <Image src={avatar} alt="" width={88} height={88} class="site-logo" loading="eager" />
        <span class="site-title">{SITE_TITLE}</span>
      </a>
      <button class="menu-btn" type="button" aria-label="Menu" aria-controls="sidebar" aria-expanded="false">
        <span class="line"></span>
      </button>
    </div>
    <nav class="site-navs">
      {
        NAV.map(({ href, label, icon }, i) => {
          return (
            <a href={href} class:list={['site-nav', { active: isActive(href) }]} style={`--i: ${i}`}>
              <FaIcon icon={icons[icon]} class="site-nav-icon" size={18} />
              <span class="site-nav-label">{label}</span>
            </a>
          );
        })
      }
      <button class="site-nav theme-toggle" type="button" aria-label="Toggle dark mode" style={`--i: ${NAV.length}`}>
        <FaIcon icon={faMoon} class="site-nav-icon icon-moon" size={18} />
        <FaIcon icon={faSun} class="site-nav-icon icon-sun" size={18} />
        <span class="site-nav-label"><span class="label-dark">Dark mode</span><span class="label-light">Light mode</span></span>
      </button>
    </nav>
  </div>
  <div class="bottom-container">
    <div class="site-description">{SITE_DESCRIPTION}</div>
    <div class="site-footer">
      Powered by <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> |
      <a class="rss" href="/rss.xml" target="_blank"><FaIcon icon={faRss} size={10} /> RSS</a>
    </div>
  </div>
</aside>

<script>
  const sidebar = document.getElementById('sidebar')!;
  const button = sidebar.querySelector<HTMLButtonElement>('.menu-btn')!;
  button.addEventListener('click', () => {
    const open = sidebar.classList.toggle('full-height');
    button.setAttribute('aria-expanded', String(open));
  });

  // Theme: the inline script in Base.astro sets data-theme before first paint.
  const root = document.documentElement;
  const toggle = sidebar.querySelector<HTMLButtonElement>('.theme-toggle')!;
  const systemDark = matchMedia('(prefers-color-scheme: dark)');

  function storedTheme(): string | null {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  }

  function applyTheme(theme: 'light' | 'dark') {
    root.dataset.theme = theme;
    toggle.setAttribute('aria-pressed', String(theme === 'dark'));
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#17191c' : '#f8f9fa');
  }

  applyTheme(root.dataset.theme === 'dark' ? 'dark' : 'light');

  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Keep following the system until the reader picks a theme themselves.
  systemDark.addEventListener('change', (e) => {
    if (!storedTheme()) applyTheme(e.matches ? 'dark' : 'light');
  });
</script>
