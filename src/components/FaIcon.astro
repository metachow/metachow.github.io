---
// Inline SVG for a Font Awesome 5 Free solid icon (icons: CC BY 4.0, https://fontawesome.com/license/free).
import type { IconDefinition } from '@fortawesome/free-solid-svg-icons';

interface Props {
  icon: IconDefinition;
  size?: number;
  class?: string;
}

const { icon, size = 16, class: className } = Astro.props;
const [width, height, , , path] = icon.icon;
---

<svg
  class={className}
  viewBox={`0 0 ${width} ${height}`}
  height={size}
  width={(size * width) / height}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  {[path].flat().map((d) => <path d={d} />)}
</svg>
